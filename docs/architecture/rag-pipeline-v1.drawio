        <mxCell id="e4" value="write" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#666666;fontSize=10" edge="1" parent="1" source="embed" target="chunks"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#666666" edge="1" parent="1" source="question" target="qembed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#666666" edge="1" parent="1" source="qembed" target="hybrid"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#666666" edge="1" parent="1" source="hybrid" target="rrf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="read" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#666666;fontSize=10;dashed=1" edge="1" parent="1" source="chunks" target="hybrid"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="top-6" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#666666;fontSize=10" edge="1" parent="1" source="rrf" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="pass" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#666666;fontSize=10" edge="1" parent="1" source="gate" target="prompt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="fail" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#b85450;fontSize=10" edge="1" parent="1" source="gate" target="refuse"><mxGeometry relative="1" as="geometry" /></mxCell>
