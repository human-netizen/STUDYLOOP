<mxfile host="app.diagrams.net" agent="StudyLoop" version="24.0.0">
  <diagram id="studyloop-rag-v1" name="RAG v1 — the measured baseline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ══ title + legend ══ -->
        <mxCell id="title" value="&lt;b&gt;StudyLoop RAG v1 — the measured baseline&lt;/b&gt;" style="text;html=1;fontSize=18;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="560" height="30" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Phases 4–11 · every v2 stage flag OFF&#10;Recall@6 0.856 · MRR 0.766 · nDCG@6 0.765 · refused 0 of 8" style="text;html=1;fontSize=12;verticalAlign=middle;align=right;fontColor=#7a1f1f;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="1000" y="14" width="390" height="40" as="geometry" />
        </mxCell>

        <!-- ══ entry points ══ -->
        <mxCell id="pdf" value="&lt;b&gt;PDF upload&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;PDF only&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="150" height="50" as="geometry" />
        </mxCell>
