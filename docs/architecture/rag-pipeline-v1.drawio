          <mxGeometry x="60" y="470" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- ══ ingestion ══ -->
        <mxCell id="ingest" value="&lt;b&gt;Ingestion&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontSize=13;fontStyle=1;dashed=1" vertex="1" parent="1">
          <mxGeometry x="260" y="80" width="600" height="180" as="geometry" />
        </mxCell>
        <mxCell id="extract" value="PDFBox Extractor&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;text layer only&lt;br&gt;a scanned page yields nothing&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="chunk" value="Fixed Chunker&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;~500 tokens · 15% overlap&lt;br&gt;never across a page boundary&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="480" y="120" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="embed" value="Text Embedder&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;Cohere embed-v4.0 · 768-d&lt;br&gt;text only&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="680" y="120" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- ══ store ══ -->
        <mxCell id="store" value="&lt;b&gt;Store&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontSize=13;fontStyle=1;dashed=1" vertex="1" parent="1">
          <mxGeometry x="900" y="80" width="260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="chunks" value="document_chunks&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;pgvector HNSW&lt;br&gt;tsvector GIN&lt;/i&gt;&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="960" y="115" width="150" height="110" as="geometry" />
        </mxCell>

        <!-- ══ retrieval ══ -->
        <mxCell id="retrieval" value="&lt;b&gt;Retrieval&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontSize=13;fontStyle=1;dashed=1" vertex="1" parent="1">
          <mxGeometry x="260" y="420" width="600" height="200" as="geometry" />
        </mxCell>
        <mxCell id="qembed" value="Query Embedder&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;the question, as written&lt;br&gt;no rewriting, no HyDE&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="280" y="460" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="hybrid" value="Hybrid Retrieval&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;vector top-20 · full-text top-20&lt;br&gt;two lists&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="480" y="460" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rrf" value="RRF Fusion&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;K=60 · 2 lists → top-6&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="680" y="460" width="160" height="70" as="geometry" />
        </mxCell>
        <mxCell id="nogap" value="no reranker · no trigram list · no visual list · no section expansion" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#7a1f1f;align=center" vertex="1" parent="1">
          <mxGeometry x="280" y="560" width="560" height="20" as="geometry" />
        </mxCell>

        <!-- ══ answering ══ -->
        <mxCell id="answer" value="&lt;b&gt;Answering&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontSize=13;fontStyle=1;dashed=1" vertex="1" parent="1">
          <mxGeometry x="900" y="420" width="480" height="200" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="Confidence Gate&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;raw cosine ≥ 0.25&lt;br&gt;one flat threshold&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="920" y="460" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="prompt" value="Prompt Assembly&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;the six chunks, as retrieved&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="1100" y="460" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="Cohere Chat&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;i&gt;SSE stream · [n] citations&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="1100" y="550" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="refuse" value="&quot;not in your materials&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="920" y="555" width="150" height="45" as="geometry" />
        </mxCell>

        <!-- ══ what is absent ══ -->
        <mxCell id="absent" value="&lt;b&gt;Not present in v1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;no evaluation harness — quality was an opinion&lt;br&gt;no semantic cache · no PPTX/DOCX/handwriting&lt;br&gt;no Bangla path · no analytics · no forum loop&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6" vertex="1" parent="1">
          <mxGeometry x="60" y="650" width="380" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Why this diagram exists.&lt;/b&gt; Phase 11.1 froze this pipeline and measured it, so every&#10;later change could be compared against one number rather than argued about. v2's&#10;★ markers are all relative to this. The 0-of-8 refusal rate is the headline: v1 could&#10;not tell a question it could answer from one it could not." style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontColor=#333333" vertex="1" parent="1">
          <mxGeometry x="470" y="650" width="620" height="90" as="geometry" />
        </mxCell>

        <!-- ══ edges ══ -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#666666" edge="1" parent="1" source="pdf" target="extract"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#666666" edge="1" parent="1" source="extract" target="chunk"><mxGeometry relative="1" as="geometry" /></mxCell>
