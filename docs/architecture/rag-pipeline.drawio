          <mxGeometry x="945" y="428" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rrf" value="&lt;b&gt;Reciprocal Rank Fusion&lt;/b&gt;&lt;br&gt;score += 1 / (60 + rank + 1) &amp;nbsp;→&amp;nbsp; top-6 chunks&lt;br&gt;&lt;i&gt;ranks only — no score calibration between two scales&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="775" y="520" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gate" value="&lt;b&gt;3. CONFIDENCE GATE&lt;/b&gt;&lt;br&gt;top cosine below 0.25&lt;br&gt;&lt;b&gt;AND&lt;/b&gt; zero lexical hits?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="635" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="prompt" value="&lt;b&gt;4. prompt assembly&lt;/b&gt;&lt;br&gt;system prompt: 6 numbered sources, &quot;cite every claim as [n],&lt;br&gt;never use outside knowledge&quot; &amp;nbsp;+&amp;nbsp; last 10 turns of history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
