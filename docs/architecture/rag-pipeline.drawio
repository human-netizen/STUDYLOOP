        </mxCell>
        <mxCell id="probe" value="&lt;b&gt;1. SEMANTIC CACHE&lt;/b&gt;&lt;br&gt;nearest stored question&lt;br&gt;at 0.97 cosine or better?&lt;br&gt;&lt;i&gt;opening questions only&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
