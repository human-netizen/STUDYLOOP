          <mxGeometry x="770" y="125" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="&lt;b&gt;embed once&lt;/b&gt; — EmbeddingClient&lt;br&gt;&lt;i&gt;the same vector is reused by retrieval,&lt;br&gt;so a cache miss costs one call, not two&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
