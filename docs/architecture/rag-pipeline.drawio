<mxfile host="app.diagrams.net" agent="StudyLoop" version="24.0.0">
  <diagram id="studyloop-rag" name="RAG pipeline">
    <mxGraphModel dx="1400" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ══ background groups ══ -->
        <mxCell id="bgIngest" value="INGESTION PIPELINE&lt;br&gt;&lt;i&gt;async — off the request thread&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f9ff;strokeColor=#9db8d9;dashed=1;verticalAlign=top;fontSize=13;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="300" height="620" as="geometry" />
        </mxCell>
        <mxCell id="bgStore" value="POSTGRESQL + PGVECTOR&lt;br&gt;&lt;i&gt;Supabase — the derived read model&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf7fd;strokeColor=#b9a3cf;dashed=1;verticalAlign=top;fontSize=13;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="390" y="60" width="300" height="620" as="geometry" />
        </mxCell>
        <mxCell id="bgQuery" value="QUERY PIPELINE&lt;br&gt;&lt;i&gt;synchronous — three gates before the provider, cheapest first&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#dcc98a;dashed=1;verticalAlign=top;fontSize=13;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="740" y="60" width="620" height="1030" as="geometry" />
        </mxCell>
        <mxCell id="bgHyb" value="2. HYBRID RETRIEVAL — RetrievalService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#7fa3cc;verticalAlign=top;fontSize=11;fontStyle=1;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="755" y="395" width="370" height="215" as="geometry" />
        </mxCell>

        <!-- ══ ingestion ══ -->
        <mxCell id="up" value="&lt;b&gt;PDF upload&lt;/b&gt;&lt;br&gt;&lt;i&gt;202 Accepted, returns at once&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="120" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ev" value="&lt;b&gt;DocumentUploadedEvent&lt;/b&gt;&lt;br&gt;&lt;i&gt;@TransactionalEventListener&lt;br&gt;AFTER_COMMIT + @Async&lt;/i&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="195" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ex" value="&lt;b&gt;EXTRACTING&lt;/b&gt;&lt;br&gt;PdfTextExtractor · PDFBox&lt;br&gt;&lt;i&gt;bytes → page texts&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="290" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="ck" value="&lt;b&gt;CHUNKING&lt;/b&gt;&lt;br&gt;TextChunker&lt;br&gt;&lt;i&gt;400 words, 60-word overlap&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="375" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eb" value="&lt;b&gt;EMBEDDING&lt;/b&gt;&lt;br&gt;DocumentEmbeddingService&lt;br&gt;&lt;i&gt;768-d vectors, batched&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="460" width="240" height="60" as="geometry" />
