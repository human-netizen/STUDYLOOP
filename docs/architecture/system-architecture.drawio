        <mxCell id="bgWeb" value="2 — WEB LAYER · @RestController — HTTP shape only, zero business rules" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f6f9fe;strokeColor=#4a6fa5;dashed=1;dashPattern=6 3;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;fontStyle=1;fontColor=#2d4666;" vertex="1" parent="1">
